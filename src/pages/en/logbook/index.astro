---
import CollectionPage from '../../../components/content/CollectionPage.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Layout from '../../../layouts/Layout.astro';
import { cardPageSize, getLocalizedEntries, paginateItems } from '../../../lib/content';
import { t } from '../../../lib/i18n';

const lang = 'en';
const page = paginateItems(await getLocalizedEntries('logbook', lang), 1, cardPageSize);
---

<Layout title={t(lang, 'titleWithSite', { title: t(lang, 'logbook'), site: t(lang, 'siteShortName') })}>
	<PageHeader eyebrow={t(lang, 'logbookEyebrow')} title={t(lang, 'logbook')} lede={t(lang, 'homeLogbookDescription')} />
	<CollectionPage
		entries={page.items}
		collection="logbook"
		lang={lang}
		view="card"
		basePath="/logbook"
		currentPage={page.currentPage}
		totalPages={page.totalPages}
	/>
</Layout>
