---
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';
import TagBadge from './TagBadge.astro';

interface Props {
	title: string;
	summary: string;
	date: Date;
	collection: 'academic' | 'notes' | 'logbook';
	lang: Lang;
	tags?: string[];
	headings?: Array<{
		depth: number;
		slug: string;
		text: string;
	}>;
	isFallback?: boolean;
	eyebrow?: string;
	externalUrl?: string;
	externalLabel?: string;
}

const {
	title,
	summary,
	date,
	collection,
	lang,
	tags = [],
	headings = [],
	isFallback = false,
	eyebrow = collection === 'academic' ? t(lang, 'academicEyebrow') : collection === 'logbook' ? t(lang, 'logbookEyebrow') : t(lang, 'notesEyebrow'),
	externalUrl,
	externalLabel,
} = Astro.props;

const formattedDate = date.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN');
const externalButtonLabel = externalLabel?.trim() || t(lang, 'openExternal');
const tocItems = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const hasTocItems = tocItems.length > 0;
const tocLabel = lang === 'en' ? 'Contents' : '目录';
const tocEmptyLabel = lang === 'en' ? 'No sections yet' : '暂无目录';
---

<article class="article-shell has-toc" data-article>
	<div class="article-layout">
	<header class="article-head">
		<p class="eyebrow">{eyebrow}</p>
		<h1>{title}</h1>
		<p class="summary">{summary}</p>
		<div class="article-meta">
			<span>{formattedDate}</span>
			{isFallback && <span class="fallback">{t(lang, 'chineseOnly')}</span>}
			{tags.map((tag) => <TagBadge tag={tag} collection={collection} lang={lang} />)}
		</div>
		{
			externalUrl && (
				<div class="article-actions">
					<a href={externalUrl} target="_blank" rel="noreferrer">{externalButtonLabel}</a>
				</div>
			)
		}
	</header>
	<aside class="article-toc" data-article-toc aria-label={tocLabel}>
		<details class="article-toc-panel" data-article-toc-details>
			<summary>
				<span>{tocLabel}</span>
				<span class="toc-count">{tocItems.length}</span>
			</summary>
			<nav class="toc-nav" aria-label={tocLabel}>
				{
					hasTocItems ? (
						tocItems.map((heading) => (
							<a
								class:list={['toc-link', `toc-depth-${heading.depth}`]}
								href={`#${heading.slug}`}
								data-toc-link
							>
								{heading.text}
							</a>
						))
					) : (
						<p class="toc-empty">{tocEmptyLabel}</p>
					)
				}
			</nav>
		</details>
	</aside>
	<div class="article-prose">
		<slot />
	</div>
	</div>
</article>

<script is:inline>
	(() => {
		const articles = document.querySelectorAll('[data-article]');

		for (const article of articles) {
			const details = article.querySelector('[data-article-toc-details]');

			if (!(details instanceof HTMLDetailsElement)) {
				continue;
			}

			const wideLayout = window.matchMedia('(min-width: 1640px)');

			const syncDetailsState = () => {
				details.open = wideLayout.matches;
			};

			syncDetailsState();
			wideLayout.addEventListener('change', syncDetailsState);

			const links = Array.from(article.querySelectorAll('[data-toc-link]'));
			const headings = Array.from(article.querySelectorAll('.article-prose :is(h2, h3)[id]'));

			if (links.length === 0 || headings.length === 0) {
				continue;
			}

			const getLinkId = (link) => {
				const rawId = link.getAttribute('href')?.slice(1) ?? '';

				try {
					return decodeURIComponent(rawId);
				} catch {
					return rawId;
				}
			};

			const activate = (id) => {
				for (const link of links) {
					const isActive = getLinkId(link) === id;
					link.classList.toggle('is-active', isActive);

					if (isActive) {
						link.setAttribute('aria-current', 'location');
					} else {
						link.removeAttribute('aria-current');
					}
				}
			};

			let lockedActiveId = '';
			let activeLockUntil = 0;

			const updateActiveLink = () => {
				if (lockedActiveId && Date.now() < activeLockUntil) {
					activate(lockedActiveId);
					return;
				}

				const activationOffset = 128;
				let currentId = headings[0].id;

				for (const heading of headings) {
					const rect = heading.getBoundingClientRect();

					if (rect.top <= activationOffset) {
						currentId = heading.id;
					} else {
						break;
					}
				}

				activate(currentId);
			};

			const observer = new IntersectionObserver(updateActiveLink, {
				rootMargin: '-128px 0px -72% 0px',
				threshold: 0,
			});

			updateActiveLink();
			window.setTimeout(updateActiveLink, 120);

			for (const heading of headings) {
				observer.observe(heading);
			}

			window.addEventListener('resize', updateActiveLink);
			window.addEventListener('hashchange', updateActiveLink);

			for (const link of links) {
				link.addEventListener('click', () => {
					const targetId = getLinkId(link);
					lockedActiveId = targetId;
					activeLockUntil = Date.now() + 420;
					activate(targetId);
					window.setTimeout(() => {
						lockedActiveId = '';
						updateActiveLink();
					}, 460);

					if (!wideLayout.matches) {
						details.open = false;
					}
				});
			}
		}
	})();
</script>

<style>
	.article-shell {
		--article-content-width: 920px;
		--article-toc-width: 220px;
		--article-toc-gap: 28px;
		width: min(100%, 920px);
		max-width: 100%;
		min-width: 0;
		margin: 0 auto;
	}

	.article-layout {
		display: block;
		max-width: 100%;
		min-width: 0;
	}

	.article-shell.has-toc .article-layout {
		display: grid;
		grid-template-areas:
			"head"
			"toc"
			"prose";
	}

	.article-head {
		grid-area: head;
		max-width: 100%;
		min-width: 0;
		padding: 10px 0 22px;
		border-bottom: 1px solid var(--line);
	}

	.eyebrow {
		margin: 0 0 10px;
		color: var(--teal);
		font-size: 0.86rem;
		font-weight: 800;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	h1 {
		max-width: 820px;
		margin: 0;
		color: var(--ink);
		font-size: 2rem;
		line-height: 1.22;
		letter-spacing: 0;
	}

	.summary {
		max-width: 760px;
		margin: 14px 0 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.78;
	}

	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-top: 16px;
		color: var(--muted);
		font-size: 0.88rem;
		font-weight: 750;
	}

	.article-actions {
		margin-top: 16px;
	}

	.article-actions a {
		display: inline-flex;
		align-items: center;
		min-height: 38px;
		padding: 0 14px;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--button-bg);
		color: var(--teal);
		font-size: 0.9rem;
		font-weight: 800;
		text-decoration: none;
	}

	.article-actions a:hover {
		background: var(--button-hover);
	}

	.fallback {
		padding: 3px 8px;
		border: 1px solid var(--line);
		border-radius: 8px;
		color: var(--teal);
		font-weight: 800;
	}

	.article-toc {
		grid-area: toc;
		width: 100%;
		max-width: 100%;
		min-width: 0;
		margin-top: 18px;
		overflow-x: hidden;
	}

	.article-toc-panel {
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--panel);
		max-width: 100%;
	}

	.article-toc-panel:not([open]) {
		overflow: hidden;
	}

	.article-toc-panel:not([open]) > :not(summary) {
		display: none;
	}

	.article-toc-panel summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 42px;
		padding: 0 12px;
		color: var(--ink);
		font-size: 0.92rem;
		font-weight: 800;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.article-toc-panel summary span:first-child {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.article-toc-panel summary::-webkit-details-marker {
		display: none;
	}

	.article-toc-panel summary::after {
		content: "";
		flex: 0 0 auto;
		width: 8px;
		height: 8px;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		margin: 0 3px;
		transform: rotate(45deg);
		transform-origin: center;
		transition: transform 160ms ease;
	}

	.article-toc-panel[open] summary::after {
		transform: rotate(225deg);
	}

	.toc-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 24px;
		height: 22px;
		margin-left: auto;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--wash);
		color: var(--muted);
		font-size: 0.78rem;
		font-weight: 800;
	}

	.toc-nav {
		display: grid;
		gap: 2px;
		max-width: 100%;
		padding: 8px 12px 10px;
		border-top: 1px solid var(--line);
		user-select: none;
	}

	.toc-link {
		display: block;
		min-width: 0;
		padding: 7px 0;
		color: var(--muted);
		font-size: 0.88rem;
		font-weight: 700;
		line-height: 1.42;
		text-decoration: none;
		overflow-wrap: anywhere;
	}

	.toc-depth-3 {
		padding-left: 16px;
		font-size: 0.84rem;
		font-weight: 650;
	}

	.toc-link:hover,
	.toc-link.is-active {
		color: var(--teal);
	}

	.toc-empty {
		margin: 0;
		padding: 7px 0;
		color: var(--muted);
		font-size: 0.88rem;
		font-weight: 700;
		line-height: 1.42;
	}

	.article-prose {
		grid-area: prose;
		max-width: 100%;
		min-width: 0;
		padding: 24px 0 42px;
		overflow-wrap: break-word;
	}

	.article-prose :global(*) {
		max-width: 100%;
	}

	.article-prose :global(p),
	.article-prose :global(li) {
		color: var(--ink);
		font-size: 1.02rem;
		line-height: 1.92;
	}

	.article-prose :global(p) {
		margin: 0 0 18px;
	}

	.article-prose :global(h2),
	.article-prose :global(h3),
	.article-prose :global(h4) {
		color: var(--ink);
		line-height: 1.35;
		letter-spacing: 0;
	}

	.article-prose :global(h2) {
		margin: 34px 0 14px;
		font-size: 1.42rem;
	}

	.article-prose :global(h3) {
		margin: 28px 0 12px;
		font-size: 1.18rem;
	}

	.article-prose :global(h2[id]),
	.article-prose :global(h3[id]) {
		scroll-margin-top: 88px;
	}

	.article-prose :global(ul),
	.article-prose :global(ol) {
		margin: 0 0 18px;
		padding-left: 1.35rem;
	}

	.article-prose :global(img) {
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 620px;
		margin: 22px auto;
		border: 1px solid var(--line);
		border-radius: 8px;
		object-fit: contain;
		box-shadow: 0 2px 10px var(--shadow);
	}

	.article-prose :global(.note-interactive) {
		display: block;
		width: 100%;
		height: min(78vh, 760px);
		min-height: 560px;
		margin: 24px 0;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--wash);
		box-shadow: 0 2px 10px var(--shadow);
	}

	.article-prose :global(blockquote) {
		margin: 22px 0;
		padding: 12px 16px;
		border-left: 4px solid var(--teal);
		background: var(--wash);
		color: var(--muted);
	}

	.article-prose :global(code) {
		padding: 2px 5px;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: var(--wash);
		font-size: 0.92em;
	}

	.article-prose :global(pre) {
		max-width: 100%;
		min-width: 0;
		overflow-x: auto;
		overflow-y: hidden;
		margin: 22px 0;
		padding: 16px;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--wash);
	}

	.article-prose :global(pre code) {
		display: block;
		max-width: none;
		width: max-content;
		min-width: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		white-space: pre;
	}

	.article-prose :global(table) {
		display: block;
		width: max-content;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
	}

	.article-prose :global(.katex-display) {
		display: block;
		max-width: 100%;
		overflow-x: auto;
		overflow-y: hidden;
		padding-bottom: 4px;
	}

	.article-prose :global(.katex-display > .katex) {
		display: inline-block;
		max-width: none;
	}

	@media (max-width: 620px) {
		.article-head {
			padding-top: 4px;
			padding-bottom: 18px;
		}

		h1 {
			font-size: 1.55rem;
		}

		.article-prose {
			padding-top: 20px;
		}

		.article-toc {
			margin-top: 14px;
		}

		.article-toc-panel summary {
			padding: 0 14px;
		}

		.toc-nav {
			padding-right: 14px;
			padding-left: 14px;
		}

		.article-prose :global(.note-interactive) {
			height: 720px;
			min-height: 720px;
		}
	}

	@media (min-width: 1280px) {
		.article-shell {
			--article-content-width: 1120px;
			width: min(100%, var(--article-content-width));
		}
	}

	@media (min-width: 1640px) {
		.article-shell.has-toc {
			width: min(100%, calc(var(--article-toc-width) + var(--article-toc-gap) + var(--article-content-width)));
		}

		.article-shell.has-toc .article-layout {
			grid-template-columns: var(--article-toc-width) minmax(0, var(--article-content-width));
			grid-template-areas:
				"toc head"
				"toc prose";
			align-items: start;
			column-gap: var(--article-toc-gap);
		}

		.article-toc {
			position: sticky;
			top: 74px;
			max-height: calc(100vh - 92px);
			margin-top: 0;
			padding-top: 8px;
			padding-right: 2px;
			overflow: visible auto;
		}

		.article-toc-panel {
			border-color: transparent;
			background: transparent;
		}

		.article-toc-panel summary {
			min-height: 36px;
			padding: 0 4px 10px 0;
			border-bottom: 1px solid var(--line);
		}

		.toc-count {
			background: var(--panel);
		}

		.toc-nav {
			padding: 10px 0 0;
			border-top: 0;
		}
	}

	@media (min-width: 1800px) {
		.article-shell {
			--article-content-width: 1280px;
			width: min(100%, var(--article-content-width));
		}

		.article-shell.has-toc {
			width: min(100%, calc(var(--article-toc-width) + var(--article-toc-gap) + var(--article-content-width)));
		}
	}
</style>
